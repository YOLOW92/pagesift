<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PagesiftLib</RootNamespace>
    <AssemblyName>Pagesift</AssemblyName>
    <PackageId>Pagesift</PackageId>
    <!-- 版本由 package.sh 用 -p:Version=... 传入，这里的值只在本地直接 build 时用 -->
    <Version>0.0.0</Version>
    <Description>.NET binding of libpagesift: HTML, PDF, Office and other documents to Markdown and JSON. Bundles the native library for linux-x64, linux-arm64 and osx-arm64.</Description>
    <Authors>YOLOW92</Authors>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/YOLOW92/pagesift</PackageProjectUrl>
    <RepositoryUrl>https://github.com/YOLOW92/pagesift</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>markdown;pdf;html;office;scraping;ffi</PackageTags>
    <!-- package.sh 传入：存放 <rid>/libpagesift.* 的目录（linux-x64、linux-arm64、osx-arm64） -->
    <PagesiftNativeDir></PagesiftNativeDir>
  </PropertyGroup>
  <ItemGroup Condition="'$(PagesiftNativeDir)' != ''">
    <None Include="$(PagesiftNativeDir)/linux-x64/libpagesift.so" Pack="true" PackagePath="runtimes/linux-x64/native/" Condition="Exists('$(PagesiftNativeDir)/linux-x64/libpagesift.so')" />
    <None Include="$(PagesiftNativeDir)/linux-arm64/libpagesift.so" Pack="true" PackagePath="runtimes/linux-arm64/native/" Condition="Exists('$(PagesiftNativeDir)/linux-arm64/libpagesift.so')" />
    <None Include="$(PagesiftNativeDir)/osx-arm64/libpagesift.dylib" Pack="true" PackagePath="runtimes/osx-arm64/native/" Condition="Exists('$(PagesiftNativeDir)/osx-arm64/libpagesift.dylib')" />
    <None Include="$(PagesiftNativeDir)/LICENSE" Pack="true" PackagePath="/" Condition="Exists('$(PagesiftNativeDir)/LICENSE')" />
    <None Include="$(PagesiftNativeDir)/NOTICE" Pack="true" PackagePath="/" Condition="Exists('$(PagesiftNativeDir)/NOTICE')" />
    <None Include="$(PagesiftNativeDir)/README.md" Pack="true" PackagePath="/" Condition="Exists('$(PagesiftNativeDir)/README.md')" />
  </ItemGroup>
</Project>
